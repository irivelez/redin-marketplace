# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
DATABASE_URL=

# WhatsApp (Colombian — swapped 2026-05-26)
WA_NUMBER=+573224347117
TONO_DATA_DIR=./data

# AppSheet (Jose's prod — READ ONLY)
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY=

# Gemini
GEMINI_API_KEY=
# Document classifier model (env-overridable so a snapshot deprecation doesn't
# break classification). Default in code: gemini-2.5-flash (current stable).
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash

# Telegram escalation (optional — leave empty in dev)
TELEGRAM_BOT_TOKEN=
HR_TELEGRAM_CHAT_ID=

# Cost kill switch — daily USD cap on Toño LLM spend (default 10)
# Drives both the agent's blocker (tono/) and the dashboard's cost widget.
TONO_DAILY_COST_USD_LIMIT=10

# ============================================================================
# LLM behavior knobs — set these to match what's running in Railway prod.
# Code defaults preserve a safe local-dev profile (Haiku, thinking on, log-only
# grounding). Production runs Sonnet with grounding still log-only.
# ============================================================================

# Anthropic model. Default in code: claude-haiku-4-5. Prod: claude-sonnet-4-5.
TONO_MODEL=claude-sonnet-4-5
MANOS_MODEL=claude-sonnet-4-5

# Extended thinking on Anthropic. Default in code: enabled (true).
# Values: "1"/"true"/"yes" → on; "0"/"false"/"no"/"off" → off.
TONO_THINKING_ENABLED=true

# Hidden reasoning budget in tokens. Min 1024 (Anthropic constraint). Default 2000.
TONO_THINKING_BUDGET=2000

# Output cap. Default = THINKING_BUDGET + 2048 when thinking on, else 2048.
# Leave unset to use the computed default.
TONO_MAX_TOKENS=

# Sampling temperature [0, 1]. Default 0.5. Ignored when TONO_THINKING_ENABLED=true
# (Anthropic API rejects the combination).
TONO_TEMPERATURE=0.5

# Grounding gate enforcement. Default in code: log-only (violations are recorded
# in turns.grounding_violations but the reply is NOT replaced).
# Set to "1"/"true"/"yes" to activate safe-fallback replacement.
# DO NOT flip without first sampling grounding_violation_logged events to
# validate false-positive rate.
TONO_GROUNDING_ENFORCE=false

# Next.js (dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WA_NUMBER=+573224347117
